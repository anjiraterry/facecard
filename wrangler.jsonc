{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facecard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": {
    "mode": "smart"
  },
  "keep_vars": true,
  "vars": {
    "ENVIRONMENT": "production"
  }
}
