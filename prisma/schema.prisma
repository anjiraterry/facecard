datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Tier {
  CLASSIC
  GOLD
  PLATINUM
  BLACK
}

enum Band {
  HARMLESS
  SUSPICIOUS
  DANGEROUS
  LETHAL
}

enum UserStatus {
  ACTIVE
  FLAGGED
  BANNED
  DELETED
}

enum ScanSource {
  SOLO
  FACEOFF
  PRACTICE
}

enum ScanSlotState {
  RESERVED
  COMMITTED
  RELEASED
}

enum LedgerType {
  SCAN
  FACEOFF_STAKE_HOLD
  FACEOFF_PAYOUT
  FACEOFF_REFUND
  FACEOFF_FEE
  FACEOFF_WIN_BONUS
  SHOP_PURCHASE
  BOUTIQUE_REFUND
  ACTIVITY_BONUS
  REVERSAL
  ADJUSTMENT
}

enum BalanceKind {
  LIFETIME
  SPENDABLE
}

enum ItemKind {
  SKIN
  TITLE
  FRAME
  BADGE
  CONSUMABLE
  FEATURE
}

enum FaceOffMode {
  STAKED
  FRIENDLY
}

enum FaceOffStatus {
  WAITING
  ACTIVE
  TIE_REMATCH
  COMPLETED
  EXPIRED
  CANCELLED
}

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  email              String?      @unique
  displayName        String
  handle             String?      @unique
  ageConfirmedAt     DateTime?
  consentVersion     String?
  consentAt          DateTime?
  lifetimePoints     Int          @default(0)
  spendableBalance   Int          @default(0)
  tier               Tier         @default(CLASSIC)
  status             UserStatus   @default(ACTIVE)
  createdAt          DateTime     @default(now())
  unlockedAt         DateTime?
  invitedByFaceOffId String?
  pinHash            String?
  avatarUrl          String?

  scans              Scan[]
  scanSlots          ScanSlot[]
  ledgerEntries      PointsLedger[]
  streak             Streak?
  cards              Card[]
  items              UserItem[]
  purchases          Purchase[]
  faceOffsChallenged FaceOff[]    @relation("ChallengerFaceOffs")
  faceOffsOpposed    FaceOff[]    @relation("OpponentFaceOffs")
  faceOffsWon        FaceOff[]    @relation("WinnerFaceOffs")
  faceOffAttempts    FaceOffAttempt[]
  shareCards         ShareCard[]
  abuseFlags         AbuseFlag[]
  auditLogs          AuditLog[]
  authSessions       AuthSession[]

  // Atelier relations
  atelierBags        ShoppingBag[]
  atelierWishlist    WishlistItem[]
  atelierAddresses   Address[]
  atelierCheckouts   CheckoutSession[]
  atelierOrders      Order[]
  skinProfile        SkinProfile?
  skinConsents       SkinConsent[]
  skincareRoutines   SkincareRoutine[]

  // Governance, social & support relations
  consentRecords      ConsentRecord[]
  friendshipsSent     Friendship[]    @relation("FriendshipRequester")
  friendshipsReceived Friendship[]    @relation("FriendshipAddressee")
  cardSnapshots       CardSnapshot[]
  supportTickets      SupportTicket[]
  productReviews      ProductReview[]

  // Boutique, Vanity & Social Gifting relations
  equipment             UserEquipment[]
  activeEffects         ActiveEffect[]
  inventoryMovements    UserItemMovement[]
  sentGifts             SocialGift[]          @relation("GiftSender")
  receivedGifts         SocialGift[]          @relation("GiftRecipient")
  giftPreference        GiftPreference?
  shopWishlist          ShopWishlistItem[]
  collectionCompletions CollectionCompletion[]
  boutiqueRefunds       BoutiqueRefund[]
  tierUpgradeEvents     TierUpgradeEvent[]
}

enum ScoringConfigKind {
  SCORING_WEIGHTS
  REWARD_POLICY
  TIER_POLICY
}

enum ScoringConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Versioned, auditable configuration (scoring weights, reward policy, tier policy).
/// Publishing never rewrites historical scans; scans store the version that produced them.
model ScoringConfigVersion {
  id            String              @id @default(uuid()) @db.Uuid
  kind          ScoringConfigKind
  version       Int
  status        ScoringConfigStatus @default(DRAFT)
  config        Json
  notes         String?
  createdById   String?             @db.Uuid
  publishedById String?             @db.Uuid
  createdAt     DateTime            @default(now())
  publishedAt   DateTime?

  @@unique([kind, version])
  @@index([kind, status])
}

/// Auditable progression event. Face Card identity is persistent; upgrades only change tier.
model TierUpgradeEvent {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  fromTier       Tier
  toTier         Tier
  lifetimePoints Int
  policyVersion  String
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toTier])
  @@index([userId, createdAt])
}

/// Server-side login session. Only a SHA-256 hash of the random cookie token is stored.
model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One-time email passcode challenge. codeHash is an HMAC, never the raw code.
model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// Generic attempt log used for rate limiting (OTP send/verify, PIN login, account claim).
model AuthAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
  @@index([createdAt])
}

model ScanSlot {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  dayKey     String        // YYYY-MM-DD Africa/Lagos
  slotIndex  Int           // 1, 2, 3
  state      ScanSlotState @default(RESERVED)
  scanId     String?       @db.Uuid
  reservedAt DateTime      @default(now())
  expiresAt  DateTime

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan       Scan?         @relation(fields: [scanId], references: [id], onDelete: SetNull)

  @@unique([userId, dayKey, slotIndex])
  @@index([userId, dayKey])
}

model Scan {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  score          Int         // 0 - 100 Lethality
  band           Band
  categoryScores Json        // Harmony, Skin Clarity, Feature Definition, Symmetry, Expression, Aura, Photo Craft
  modelVersion   String
  promptVersion  String
  scanIndexOfDay Int
  dayKey         String      // YYYY-MM-DD Africa/Lagos
  source         ScanSource  @default(SOLO)
  faceOffId      String?     @db.Uuid
  createdAt      DateTime    @default(now())

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  faceOff        FaceOff?    @relation("FaceOffScans", fields: [faceOffId], references: [id], onDelete: SetNull)
  faceOffAttempts FaceOffAttempt[]
  scanSlots      ScanSlot[]
  challengerBestInFaceOffs FaceOff[] @relation("ChallengerBestScan")
  opponentBestInFaceOffs   FaceOff[] @relation("OpponentBestScan")
  shareCards     ShareCard[]

  @@index([userId, dayKey])
}

model PointsLedger {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  type           LedgerType
  amount         Int
  balanceKind    BalanceKind
  refType        String?
  refId          String?
  idempotencyKey String
  createdAt      DateTime    @default(now())

  // Non-cascading FK to prevent deleting financial ledger records on user deletion
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([idempotencyKey, balanceKind])
  @@index([userId, createdAt])
}

model Streak {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  currentCount   Int      @default(1)
  longestCount   Int      @default(1)
  lastScanDayKey String
  freezesHeld    Int      @default(0)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Card {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  cardNumber      String    @unique
  equippedSkinId  String?   @db.Uuid
  equippedTitleId String?   @db.Uuid
  equippedFrameId String?   @db.Uuid
  slot            Int       @default(1)
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equippedSkin    ShopItem? @relation("CardSkin", fields: [equippedSkinId], references: [id], onDelete: SetNull)
  equippedTitle   ShopItem? @relation("CardTitle", fields: [equippedTitleId], references: [id], onDelete: SetNull)
  equippedFrame   ShopItem? @relation("CardFrame", fields: [equippedFrameId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model ShopItem {
  id               String             @id @default(uuid()) @db.Uuid
  sku              String?            @unique
  slug             String             @unique
  kind             ItemKind
  category         String             @default("CARDS")
  rarity           ItemRarity         @default(ESSENTIAL)
  status           BoutiqueItemStatus @default(PUBLISHED)
  slot             EquipmentSlot?
  effectKind       EffectKind?
  effectConfig     Json?
  isGiftable       Boolean            @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  currentVersionId String?            @db.Uuid
  name             String
  description      String?
  price            Int
  minTier          Tier               @default(CLASSIC)
  maxOwned         Int                @default(1)
  active           Boolean            @default(true)
  assetRef         String?
  createdAt        DateTime           @default(now())

  userItems        UserItem[]
  purchases        Purchase[]
  versions         ShopItemVersion[]
  equipment        UserEquipment[]
  activeEffects    ActiveEffect[]
  inventoryMoves   UserItemMovement[]
  socialGifts      SocialGift[]
  wishlistItems    ShopWishlistItem[]
  collectionItems  ShopCollectionItem[]
  cardSkins        Card[]             @relation("CardSkin")
  cardTitles       Card[]             @relation("CardTitle")
  cardFrames       Card[]             @relation("CardFrame")
}

model UserItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  itemId     String   @db.Uuid
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  item           ShopItem            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  equipment      UserEquipment[]
  activeEffects  ActiveEffect[]
  movements      UserItemMovement[]

  @@unique([userId, itemId])
}

model Purchase {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  itemId         String   @db.Uuid
  itemVersionId  String?  @db.Uuid
  quantity       Int      @default(1)
  price          Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  item           ShopItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemVersion    ShopItemVersion? @relation(fields: [itemVersionId], references: [id], onDelete: SetNull)
  socialGifts    SocialGift[]
  refunds        BoutiqueRefund[]

  @@index([userId])
}

model FaceOff {
  id                   String        @id @default(uuid()) @db.Uuid
  challengerId         String        @db.Uuid
  opponentId           String?       @db.Uuid
  inviteCode           String        @unique
  mode                 FaceOffMode   @default(STAKED)
  stake                Int           @default(0)
  status               FaceOffStatus @default(WAITING)
  challengerBestScanId String?       @db.Uuid
  opponentBestScanId   String?       @db.Uuid
  winnerId             String?       @db.Uuid
  rematchCount         Int           @default(0)
  feeAmount            Int           @default(0)
  challengerLockedAt   DateTime?
  opponentLockedAt     DateTime?
  expiresAt            DateTime
  resolvedAt           DateTime?
  createdAt            DateTime      @default(now())

  challenger           User          @relation("ChallengerFaceOffs", fields: [challengerId], references: [id], onDelete: Restrict)
  opponent             User?         @relation("OpponentFaceOffs", fields: [opponentId], references: [id], onDelete: Restrict)
  winner               User?         @relation("WinnerFaceOffs", fields: [winnerId], references: [id], onDelete: SetNull)
  challengerBestScan   Scan?         @relation("ChallengerBestScan", fields: [challengerBestScanId], references: [id], onDelete: SetNull)
  opponentBestScan     Scan?         @relation("OpponentBestScan", fields: [opponentBestScanId], references: [id], onDelete: SetNull)
  scans                Scan[]        @relation("FaceOffScans")
  attempts             FaceOffAttempt[]
  shareCards           ShareCard[]

  @@index([inviteCode])
  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([expiresAt])
}

model FaceOffAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  faceOffId     String   @db.Uuid
  userId        String   @db.Uuid
  scanId        String   @db.Uuid
  attemptNumber Int      // 1 to 3
  createdAt     DateTime @default(now())

  faceOff       FaceOff  @relation(fields: [faceOffId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan          Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([faceOffId, userId])
}

model ShareCard {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  publicId   String        @unique
  scanId     String?       @db.Uuid
  faceOffId  String?       @db.Uuid
  snapshotId String?       @db.Uuid
  blobKey    String
  expiresAt  DateTime
  deletedAt  DateTime?
  createdAt  DateTime      @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  scan       Scan?         @relation(fields: [scanId], references: [id], onDelete: SetNull)
  faceOff    FaceOff?      @relation(fields: [faceOffId], references: [id], onDelete: SetNull)
  snapshot   CardSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([publicId])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  userId      String?  @db.Uuid
  route       String
  requestHash String
  status      Int
  responseBody Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([key])
  @@index([expiresAt])
}

model EconomyConfig {
  version    Int      @id
  values     Json
  activeFrom DateTime @default(now())
}

model AbuseFlag {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  reason     String
  severity   String
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  outcome    String?

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ==========================================
// THE ATELIER — SKINCARE COMMERCE & ROUTINES
// ==========================================

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RitualStepKind {
  CLEANSE
  TREAT
  HYDRATE
  PROTECT
}

enum InventoryMovementType {
  STOCK_RECEIVED
  RESERVED
  RESERVATION_RELEASED
  SALE
  RETURN_RESTOCK
  DAMAGED
  EXPIRED
  ADJUSTMENT
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum BagStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum CheckoutStatus {
  OPEN
  COMPLETED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfilmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  PAYSTACK
}

enum SkinType {
  NORMAL
  DRY
  OILY
  COMBINATION
  UNSURE
}

enum SensitivityLevel {
  NOT_REPORTED
  OCCASIONAL
  FREQUENT
  UNSURE
}

enum RoutineExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum RoutinePreference {
  MINIMAL
  BALANCED
  ADVANCED
}

enum TimeOfDay {
  AM
  PM
}

model Brand {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  description String?
  country     String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  products    AtelierProduct[]
}

model ProductCategory {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  description String?
  parentId    String?          @db.Uuid
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())

  parent      ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryTree")
  products    AtelierProduct[]
}

model AtelierProduct {
  id              String              @id @default(uuid()) @db.Uuid
  slug            String              @unique
  brandId         String              @db.Uuid
  categoryId      String              @db.Uuid
  name            String
  subtitle        String?
  description     String
  benefits        String[]
  howToUse        String?
  warnings        String?
  ingredientList  String?
  countryOfOrigin String?
  ritualStep      RitualStepKind      @default(TREAT)
  status          ProductStatus       @default(DRAFT)
  featured        Boolean             @default(false)
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  archivedAt      DateTime?

  brand           Brand               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category        ProductCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants        ProductVariant[]
  images          ProductImage[]
  ingredients     ProductIngredient[]
  concerns        ProductConcern[]
  skinTypes       ProductSkinType[]
  collections     CollectionProduct[]
  wishlistItems   WishlistItem[]
  routineSteps    RoutineStepProduct[]
  reviews         ProductReview[]

  @@index([status, featured])
  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id                  String                 @id @default(uuid()) @db.Uuid
  productId           String                 @db.Uuid
  sku                 String                 @unique
  barcode             String?                @unique
  name                String
  sizeLabel           String?
  volumeMl            Decimal?               @db.Decimal(10, 2)
  weightGrams         Decimal?               @db.Decimal(10, 2)
  priceMinor          BigInt
  compareAtPriceMinor BigInt?
  costPriceMinor      BigInt?
  currency            String                 @default("NGN")
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  product             AtelierProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLevels     InventoryLevel[]
  inventoryMovements  InventoryMovement[]
  reservations        InventoryReservation[]
  bagItems            BagItem[]
  orderItems          OrderItem[]

  @@index([productId, isActive])
}

model ProductImage {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @db.Uuid
  objectKey String
  altText   String?
  sortOrder Int            @default(0)
  isPrimary Boolean        @default(false)
  createdAt DateTime       @default(now())

  product   AtelierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Ingredient {
  id                String              @id @default(uuid()) @db.Uuid
  slug              String              @unique
  name              String
  inciName          String?
  summary           String?
  isPotentialIrritant Boolean           @default(false)

  products          ProductIngredient[]
}

model ProductIngredient {
  productId    String         @db.Uuid
  ingredientId String         @db.Uuid
  isKeyActive  Boolean        @default(false)

  product      AtelierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model SkinConcern {
  id          String               @id @default(uuid()) @db.Uuid
  slug        String               @unique
  name        String
  description String?

  products    ProductConcern[]
  profiles    SkinProfileConcern[]
}

model ProductConcern {
  productId String         @db.Uuid
  concernId String         @db.Uuid
  strength  Int            @default(1)

  product   AtelierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  concern   SkinConcern    @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([productId, concernId])
}

model ProductSkinType {
  productId String         @db.Uuid
  skinType  SkinType

  product   AtelierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, skinType])
}

model Collection {
  id          String              @id @default(uuid()) @db.Uuid
  slug        String              @unique
  name        String
  description String?
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())

  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String         @db.Uuid
  productId    String         @db.Uuid
  sortOrder    Int            @default(0)

  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      AtelierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model InventoryLocation {
  id          String                 @id @default(uuid()) @db.Uuid
  code        String                 @unique
  name        String
  city        String?
  state       String?
  country     String                 @default("NG")
  isDefault   Boolean                @default(false)
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())

  levels      InventoryLevel[]
  movements   InventoryMovement[]
  reservations InventoryReservation[]
}

model InventoryLevel {
  id           String            @id @default(uuid()) @db.Uuid
  variantId    String            @db.Uuid
  locationId   String            @db.Uuid
  onHand       Int               @default(0)
  reserved     Int               @default(0)
  reorderLevel Int               @default(5)
  version      Int               @default(1)
  updatedAt    DateTime          @updatedAt

  variant      ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location     InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  variantId     String                @db.Uuid
  locationId    String                @db.Uuid
  type          InventoryMovementType
  onHandDelta   Int
  reservedDelta Int
  referenceType String
  referenceId   String
  operationKey  String                @unique
  performedById String?               @db.Uuid
  reason        String?
  createdAt     DateTime              @default(now())

  variant       ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location      InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
}

model InventoryReservation {
  id                String            @id @default(uuid()) @db.Uuid
  checkoutSessionId String            @db.Uuid
  variantId         String            @db.Uuid
  locationId        String            @db.Uuid
  quantity          Int
  status            ReservationStatus @default(ACTIVE)
  expiresAt         DateTime
  consumedAt        DateTime?
  releasedAt        DateTime?
  createdAt         DateTime          @default(now())

  checkoutSession   CheckoutSession   @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([checkoutSessionId])
}

model ShoppingBag {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  status    BagStatus @default(ACTIVE)
  currency  String    @default("NGN")
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BagItem[]

  @@index([userId, status])
}

model BagItem {
  id        String         @id @default(uuid()) @db.Uuid
  bagId     String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  bag       ShoppingBag    @relation(fields: [bagId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([bagId, variantId])
}

model WishlistItem {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  productId String         @db.Uuid
  createdAt DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   AtelierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  country       String   @default("NG")
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeliveryZone {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique
  name      String
  states    String[]
  active    Boolean        @default(true)

  rates     ShippingRate[]
}

model ShippingRate {
  id            String       @id @default(uuid()) @db.Uuid
  zoneId        String       @db.Uuid
  name          String
  amountMinor   BigInt
  currency      String       @default("NGN")
  estimatedDays String?
  active        Boolean      @default(true)

  zone          DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model CheckoutSession {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @db.Uuid
  bagId          String?                @db.Uuid
  status         CheckoutStatus         @default(OPEN)
  currency       String                 @default("NGN")
  subtotalMinor  BigInt
  discountMinor  BigInt                 @default(0)
  shippingMinor  BigInt                 @default(0)
  taxMinor       BigInt                 @default(0)
  totalMinor     BigInt
  addressSnapshot Json
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations   InventoryReservation[]
  order          Order?

  @@index([userId, status])
  @@index([expiresAt])
}

model Order {
  id                String             @id @default(uuid()) @db.Uuid
  orderNumber       String             @unique
  userId            String             @db.Uuid
  checkoutSessionId String             @unique @db.Uuid
  currency          String             @default("NGN")
  subtotalMinor     BigInt
  discountMinor     BigInt             @default(0)
  shippingMinor     BigInt             @default(0)
  taxMinor          BigInt             @default(0)
  totalMinor        BigInt
  orderStatus       OrderStatus        @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus      @default(PENDING)
  fulfilmentStatus  FulfilmentStatus   @default(UNFULFILLED)
  placedAt          DateTime           @default(now())
  paidAt            DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  checkoutSession   CheckoutSession    @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  address           OrderAddress?
  statusEvents      OrderStatusEvent[]
  transactions      PaymentTransaction[]

  @@index([userId, createdAt])
}

model OrderItem {
  id                  String         @id @default(uuid()) @db.Uuid
  orderId             String         @db.Uuid
  variantId           String         @db.Uuid
  productNameSnapshot String
  brandNameSnapshot   String
  variantNameSnapshot String
  skuSnapshot         String
  imageKeySnapshot    String?
  quantity            Int
  unitPriceMinor      BigInt
  discountMinor       BigInt         @default(0)
  taxMinor            BigInt         @default(0)
  lineTotalMinor      BigInt

  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OrderAddress {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @unique @db.Uuid
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  state         String
  country       String
  postalCode    String?

  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusEvent {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  fromStatus  String?
  toStatus    String
  note        String?
  actorId     String?  @db.Uuid
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model PaymentTransaction {
  id                    String          @id @default(uuid()) @db.Uuid
  orderId               String          @db.Uuid
  provider              PaymentProvider @default(PAYSTACK)
  reference             String          @unique
  providerTransactionId String?
  amountMinor           BigInt
  currency              String          @default("NGN")
  status                PaymentStatus   @default(PENDING)
  failureReason         String?
  verifiedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    PaymentProvider @default(PAYSTACK)
  eventId     String    @unique
  eventType   String
  reference   String?
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([reference])
}

model SkinProfile {
  id                   String                   @id @default(uuid()) @db.Uuid
  userId               String                   @unique @db.Uuid
  skinType             SkinType                 @default(UNSURE)
  sensitivityLevel     SensitivityLevel?
  experienceLevel      RoutineExperience?
  routinePreference    RoutinePreference?
  budgetMinMinor       BigInt?
  budgetMaxMinor       BigInt?
  preferredCurrency    String                   @default("NGN")
  questionnaireVersion Int                      @default(1)
  completedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  concerns             SkinProfileConcern[]
  sensitivities        SkinProfileSensitivity[]
}

model SkinProfileConcern {
  skinProfileId String      @db.Uuid
  concernId     String      @db.Uuid
  priority      Int         @default(1)

  skinProfile   SkinProfile @relation(fields: [skinProfileId], references: [id], onDelete: Cascade)
  concern       SkinConcern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([skinProfileId, concernId])
}

model SkinProfileSensitivity {
  id            String      @id @default(uuid()) @db.Uuid
  skinProfileId String      @db.Uuid
  label         String

  skinProfile   SkinProfile @relation(fields: [skinProfileId], references: [id], onDelete: Cascade)

  @@unique([skinProfileId, label])
}

model SkinConsent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  version     String
  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, grantedAt])
}

model SkincareRoutine {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  name      String        @default("My Daily Ritual")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps     RoutineStep[]

  @@index([userId, isActive])
}

model RoutineStep {
  id         String               @id @default(uuid()) @db.Uuid
  routineId  String               @db.Uuid
  timeOfDay  TimeOfDay
  stepNumber Int
  stepTitle  String
  guidance   String?

  routine    SkincareRoutine      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  products   RoutineStepProduct[]

  @@unique([routineId, timeOfDay, stepNumber])
}

model RoutineStepProduct {
  stepId    String         @db.Uuid
  productId String         @db.Uuid

  step      RoutineStep    @relation(fields: [stepId], references: [id], onDelete: Cascade)
  product   AtelierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([stepId, productId])
}

// ═════════════════════════════════════════════════════════════════════════════
// GOVERNANCE, SOCIAL, IMMUTABLE SNAPSHOTS & CONTROL CENTRE
// ═════════════════════════════════════════════════════════════════════════════

enum ConsentPurpose {
  AGE_CONFIRMATION
  TERMS_PRIVACY
  PORTRAIT_PROCESSING
  SKINCARE_PERSONALISATION
  PUBLIC_SHARE
}

model ConsentRecord {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  purpose     ConsentPurpose
  version     String
  grantedAt   DateTime       @default(now())
  withdrawnAt DateTime?
  ip          String?
  userAgent   String?

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId String           @db.Uuid
  addresseeId String           @db.Uuid
  status      FriendshipStatus @default(ACCEPTED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model CardSnapshot {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  cardId          String
  cardholderName  String
  handle          String?
  tier            Tier
  score           Float
  band            String?
  title           String
  skinSlug        String
  frameSlug       String
  streakDays      Int         @default(0)
  multiplier      Float       @default(1.0)
  templateVersion String      @default("1.0")
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareCards      ShareCard[]

  @@index([userId, createdAt])
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model StaffRole {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  name        String
  description String?
  permissions String[]    @default([])
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users       StaffUser[]
}

model StaffUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  fullName     String
  passwordHash String
  status       StaffStatus     @default(ACTIVE)
  roleId       String          @db.Uuid
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  role         StaffRole         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions     StaffSession[]
  auditLogs    StaffAuditLog[]
  proposedApprovals ApprovalRequest[] @relation("ApprovalProposer")
  reviewedApprovals ApprovalRequest[] @relation("ApprovalReviewer")

  @@index([roleId])
}

model StaffSession {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String    @db.Uuid
  tokenHash   String    @unique
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId])
  @@index([expiresAt])
}

model StaffAuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  staffUserId String?   @db.Uuid
  action      String
  targetType  String
  targetId    String?
  reason      String?
  detail      Json?
  ip          String?
  createdAt   DateTime  @default(now())

  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([staffUserId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @db.Uuid
  email     String?
  subject   String
  category  String
  status    SupportTicketStatus @default(OPEN)
  priority  String              @default("NORMAL")
  orderId   String?             @db.Uuid
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([status, createdAt])
  @@index([userId])
}

model SupportMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @db.Uuid
  senderType String        // USER | STAFF | SYSTEM
  senderId   String?       @db.Uuid
  body       String
  createdAt  DateTime      @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id           String         @id @default(uuid()) @db.Uuid
  proposerId   String         @db.Uuid
  reviewerId   String?        @db.Uuid
  actionType   String         // POINTS_ADJUSTMENT | STOCK_WRITE_OFF | USER_SUSPENSION | REFUND_REQUEST
  targetType   String
  targetId     String
  payload      Json
  reason       String
  status       ApprovalStatus @default(PENDING)
  decisionNote String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  proposer     StaffUser      @relation("ApprovalProposer", fields: [proposerId], references: [id], onDelete: Restrict)
  reviewer     StaffUser?     @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([proposerId])
  @@index([targetType, targetId])
}

model ProductReview {
  id               String         @id @default(uuid()) @db.Uuid
  productId        String         @db.Uuid
  userId           String         @db.Uuid
  rating           Int            // 1 to 5
  title            String?
  body             String
  skinType         SkinType?
  verifiedPurchase Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  product          AtelierProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

// ==========================================
// BOUTIQUE, VANITY & SOCIAL ECONOMY
// ==========================================

enum BoutiqueItemStatus {
  DRAFT
  VALIDATED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  PAUSED
  RETIRED
}

enum ItemRarity {
  ESSENTIAL
  SIGNATURE
  COLLECTOR
  EXCLUSIVE
}

enum EquipmentSlot {
  CARD_SKIN
  CARD_FRAME
  AVATAR_FRAME
  AVATAR_EFFECT
  PROFILE_BACKGROUND
  PROFILE_EFFECT
  PROFILE_TITLE
  NAMEPLATE
  ARENA_ENTRANCE
  ARENA_VICTORY
  ARENA_THEME
  SHARE_TEMPLATE
  ROUTINE_THEME
}

enum EffectKind {
  EQUIP_COSMETIC
  STREAK_PROTECTION
  REWARD_MULTIPLIER
  FEATURE_ENTITLEMENT
  CAPACITY_INCREASE
  SOCIAL_GIFT
  PROFILE_SHOWCASE
  EXPORT_ENTITLEMENT
  COLLECTION_COMPLETION
}

enum ActiveEffectStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

enum SocialGiftStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REFUNDED
}

enum BoutiqueRefundStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model ShopItemVersion {
  id              String     @id @default(uuid()) @db.Uuid
  itemId          String     @db.Uuid
  version         Int
  name            String
  description     String?
  rarity          ItemRarity @default(ESSENTIAL)
  pricePoints     Int
  ownershipPolicy String     @default("PERMANENT")
  giftPolicy      Json?
  maxOwned        Int        @default(1)
  effectKind      EffectKind
  effectConfig    Json
  handlerVersion  String     @default("1.0")
  assetRef        String?
  createdAt       DateTime   @default(now())

  item            ShopItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  purchases       Purchase[]
  socialGifts     SocialGift[]

  @@unique([itemId, version])
  @@index([itemId])
}

model UserEquipment {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  slot       EquipmentSlot
  userItemId String        @db.Uuid
  itemId     String        @db.Uuid
  equippedAt DateTime      @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userItem   UserItem      @relation(fields: [userItemId], references: [id], onDelete: Cascade)
  item       ShopItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([userId, slot])
  @@index([userId])
}

model ActiveEffect {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @db.Uuid
  userItemId           String             @db.Uuid
  itemId               String             @db.Uuid
  effectKind           EffectKind
  config               Json
  status               ActiveEffectStatus @default(ACTIVE)
  startsAt             DateTime           @default(now())
  expiresAt            DateTime?
  remainingUses        Int?
  remainingBonusPoints Int?
  terminalReason       String?
  endedAt              DateTime?
  createdAt            DateTime           @default(now())

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userItem             UserItem           @relation(fields: [userItemId], references: [id], onDelete: Cascade)
  item                 ShopItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  executions           EffectExecution[]

  @@index([userId, status])
  @@index([expiresAt])
}

model EffectExecution {
  id                 String       @id @default(uuid()) @db.Uuid
  activeEffectId     String       @db.Uuid
  eventId            String
  targetModule       String
  result             String
  consumedUses       Int          @default(1)
  bonusPointsAwarded Int          @default(0)
  metadata           Json?
  executedAt         DateTime     @default(now())

  activeEffect       ActiveEffect @relation(fields: [activeEffectId], references: [id], onDelete: Cascade)

  @@unique([activeEffectId, eventId])
  @@index([executedAt])
}

model UserItemMovement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  userItemId    String   @db.Uuid
  itemId        String   @db.Uuid
  quantityDelta Int
  reason        String
  referenceId   String?
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userItem      UserItem @relation(fields: [userItemId], references: [id], onDelete: Cascade)
  item          ShopItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model SocialGift {
  id            String           @id @default(uuid()) @db.Uuid
  senderId      String           @db.Uuid
  recipientId   String           @db.Uuid
  itemId        String           @db.Uuid
  itemVersionId String?          @db.Uuid
  purchaseId    String?          @db.Uuid
  status        SocialGiftStatus @default(PENDING)
  message       String?
  expiresAt     DateTime
  acceptedAt    DateTime?
  declinedAt    DateTime?
  createdAt     DateTime         @default(now())

  sender        User             @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient     User             @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  item          ShopItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemVersion   ShopItemVersion? @relation(fields: [itemVersionId], references: [id], onDelete: SetNull)
  purchase      Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([recipientId, status])
  @@index([senderId, createdAt])
}

model GiftPreference {
  userId         String   @id @db.Uuid
  enabled        Boolean  @default(true)
  allowedSenders String   @default("ALL") // ALL | FRIENDS_ONLY | NONE
  publicDisplay  Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ShopWishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  itemId    String   @db.Uuid
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model ShopCollection {
  id          String             @id @default(uuid()) @db.Uuid
  name        String
  slug        String             @unique
  description String?
  status      BoutiqueItemStatus @default(PUBLISHED)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime           @default(now())

  items       ShopCollectionItem[]
  completions CollectionCompletion[]
}

model ShopCollectionItem {
  id           String         @id @default(uuid()) @db.Uuid
  collectionId String         @db.Uuid
  itemId       String         @db.Uuid
  required     Boolean        @default(true)

  collection   ShopCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item         ShopItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, itemId])
}

model CollectionCompletion {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  collectionId String         @db.Uuid
  completedAt  DateTime       @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   ShopCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
}

model BoutiqueRefund {
  id                 String               @id @default(uuid()) @db.Uuid
  purchaseId         String               @db.Uuid
  userId             String               @db.Uuid
  pointsRefunded     Int
  reason             String
  status             BoutiqueRefundStatus @default(REQUESTED)
  requestedByStaffId String?              @db.Uuid
  approvedByStaffId  String?              @db.Uuid
  createdAt          DateTime             @default(now())
  resolvedAt         DateTime?

  purchase           Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

